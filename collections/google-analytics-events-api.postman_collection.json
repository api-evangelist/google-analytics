          "name": "Google Analytics Send Events to Google Analytics",
          "request": {
            "name": "Google Analytics Send Events to Google Analytics",
            "description": {
              "content": "Sends one or more events to Google Analytics for processing. Up to 25 events can be sent per request. Events can be backdated up to 72 hours.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "collect"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_secret",
                  "value": "<string>",
                  "description": "(Required) The API Secret generated in the Google Analytics UI. Found under Admin > Data Streams > Choose your stream > Measurement Protocol > Create."
                },
                {
                  "disabled": false,
                  "key": "measurement_id",
                  "value": "<string>",
                  "description": "The Measurement ID for a web data stream. Required for web streams. Found in the Google Analytics UI under Admin > Data Streams."
                },
                {
                  "disabled": false,
                  "key": "firebase_app_id",
                  "value": "<string>",
                  "description": "The Firebase App ID for an app data stream. Required for app streams. Found in the Firebase console under Project Settings."
                }
              ],
              "variable": []
            },
